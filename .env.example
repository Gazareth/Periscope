# Cloudflare R2 (S3 API) credentials.
# Create an API token at: Cloudflare dashboard > R2 > Manage API tokens (Object Read is enough).
# Needed at build time (prerendered versions) and at runtime (older versions load on first visit).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the endpoint, e.g. https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Screenshots live at <R2_BUCKET>/<PERISCOPE_ORG>/<PERISCOPE_REPO>/<version>/...
R2_BUCKET=app-screenshots
PERISCOPE_ORG=gazareth
PERISCOPE_REPO=european-shibu

# Prerendered at build time: the main branch plus the newest N releases.
PERISCOPE_MAIN_BRANCH=develop
PERISCOPE_STATIC_RELEASES=2

# Optional: password-protect the site with a login page. Leave unset for no password.
# PERISCOPE_PASSWORD=
